[init]
	defaultBranch = main
[core]
	editor = vim
[pull]
	ff = only
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[rerere]
	enabled = true
[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
[rebase]
	autoStash = true
	updateRefs = true
[branch]
	sort = -committerdate
[commit]
	verbose = true
[alias]
	st = status --short --branch
	co = checkout
	sw = switch
	br = branch
	ci = commit
	last = log -1 --oneline
	graph = log --graph --oneline --decorate --all

# Identity and machine-specific settings; included last so they win.
[include]
	path = ~/.gitconfig.local
